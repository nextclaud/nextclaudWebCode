{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{css,js,png,jpg,jpeg,gif,webp,svg,ico,html,mjs}"]
  },
  "routes": [
    { "route": "/about", "rewrite": "/about.html" },
    { "route": "/services", "rewrite": "/services.html" },
    { "route": "/pricing", "rewrite": "/pricing.html" },
    { "route": "/contact", "rewrite": "/contact.html" },
    { "route": "/privacy-policy", "rewrite": "/privacy-policy.html" },
    { "route": "/terms-and-conditions", "rewrite": "/terms-and-conditions.html" },
    { "route": "/privacy", "redirect": "/privacy-policy", "statusCode": 301 },
    { "route": "/terms", "redirect": "/terms-and-conditions", "statusCode": 301 },
    { "route": "/terms-conditions", "redirect": "/terms-and-conditions", "statusCode": 301 },
    { "route": "/terms-conditions.html", "redirect": "/terms-and-conditions.html", "statusCode": 301 },
    { "route": "/clients", "redirect": "/about", "statusCode": 301 },
    { "route": "/faqs", "redirect": "/contact", "statusCode": 301 },
    { "route": "/whatsapp-business-pricing", "redirect": "/pricing", "statusCode": 301 }
  ]
}
